# Django settings
SECRET_KEY='your_strong_secret_key_here_generate_a_new_one'
DEBUG=True # Set to False in production
ALLOWED_HOSTS=localhost,127.0.0.1,your_domain.com # Comma-separated

# Database settings (for docker-compose)
POSTGRES_USER=fitmeuser
POSTGRES_PASSWORD=fitmepassword_change_this
POSTGRES_DB=fitmedb
# DATABASE_URL will be constructed by docker-compose or you can set it explicitly if not using the default structure:
# DATABASE_URL=postgres://fitmeuser:fitmepassword_change_this@db:5432/fitmedb

# Port mapping for Django app
DJANGO_PORT=8000

# Media files mount configuration (IMPORTANT FOR /mnt/workout)
# Path on the LXC host where /mnt/workout is available (or a subfolder of it for this app)
MEDIA_FILES_MOUNT_PATH_ON_HOST=/mnt/workout/fitme_media
# Path inside the 'web' container where Django's MEDIA_ROOT will point
MEDIA_ROOT_IN_CONTAINER=/app/mediafiles
# Ensure settings.py uses os.getenv('MEDIA_ROOT', BASE_DIR / 'mediafiles')
